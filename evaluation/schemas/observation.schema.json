{
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "profile": {
      "type": "object",
      "properties": {
        "patient_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "failed"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section": {
                "enum": [
                  "condition",
                  "medication",
                  "allergy",
                  "lab",
                  "vital"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "qualifier": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "section",
              "key",
              "value",
              "date",
              "qualifier",
              "source_ids"
            ],
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "code",
              "text",
              "source_ids"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_id",
              "version",
              "excerpt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "patient_id",
        "status",
        "facts",
        "gaps",
        "conflicts",
        "sources"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "patient_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ok",
              "empty",
              "unavailable",
              "denied"
            ]
          },
          "returned_record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          }
        },
        "required": [
          "tool",
          "arguments",
          "patient_id",
          "status",
          "returned_record_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "case_id",
    "http_status",
    "profile",
    "tool_calls"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
