MODEL_BACKEND=stub
MODEL_ID=offline-stub

# OpenAI (native API; optional OPENAI_BASE_URL override for gateways):
# MODEL_BACKEND=openai
# MODEL_ID=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini via OpenAI compatibility (https://ai.google.dev/gemini-api/docs/openai):
# MODEL_BACKEND=google
# MODEL_ID=gemini-3.5-flash-lite
# GOOGLE_API_KEY=your-gemini-api-key

# Other OpenAI-compatible provider:
# MODEL_BACKEND=custom
# MODEL_ID=your-model-id
# MODEL_API_KEY=your-provider-api-key
# MODEL_BASE_URL=https://your-provider.example/v1
MCP_REGISTRY_PATH=config/mcp_servers.json
# Required for MCP JWT issuance: RSA private key paired with the records MCP verification key.
# Do not commit key material. Generate once and reuse the same pair locally:
#   (cd records-mcp && ./scripts/generate_dev_keys.sh)
#   MCP_SIGNING_KEY_PATH=../records-mcp/secrets/mcp-signing-key.pem
# Or agent-only key (must export matching public key to records MCP separately):
#   ./scripts/generate_dev_signing_key.sh
MCP_SIGNING_KEY_PATH=../records-mcp/secrets/mcp-signing-key.pem
# Optional out-of-band evaluator hook file (same shape as evaluation active_faults.json).
# AGENT_TEST_FAULT_FILE=../evaluation/var/evaluation/active_faults.json
MCP_TOKEN_ISSUER=clinician-agent-api
MCP_REQUEST_ORIGIN=http://127.0.0.1:8000
DEMO_SESSIONS_PATH=secrets/demo-sessions.json
AGENT_DB_PATH=var/agent/clinician-agent.sqlite3
WEB_ORIGIN=http://127.0.0.1:5173
OTEL_SERVICE_NAME=clinician-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
APP_ENV=local
